{
  "name": "@plaguefps/img",
  "version": "0.3.0",
  "description": "An agent-friendly image optimization CLI built with Effect, powered by Sharp.",
  "homepage": "https://github.com/PlagueFPS/img#readme",
  "bugs": {
    "url": "https://github.com/PlagueFPS/img/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlagueFPS/img.git"
  },
  "bin": {
    "img": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "tools/postinstall.mjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "bench": "node --experimental-strip-types tools/bench/webp.ts",
    "dev": "vp pack --watch",
    "test": "vp pack && vp test",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "effect-tsgo tsc --noEmit",
    "prepack": "pnpm run build",
    "postinstall": "node tools/postinstall.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.2",
    "effect": "^4.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "0.64.1",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.16.1"
}
