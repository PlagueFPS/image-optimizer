{
  "name": "@plaguefps/image-optimizer",
  "version": "0.1.0",
  "description": "Configurable Effect-native image optimization CLI",
  "license": "MIT",
  "bin": {
    "image-optimizer": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "tools/postinstall.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp pack && vp test",
    "typecheck": "effect-tsgo tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "prepack": "pnpm run build",
    "postinstall": "node tools/postinstall.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.2",
    "effect": "^4.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.16.1"
}
